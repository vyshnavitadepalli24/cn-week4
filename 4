#include <stdio.h>

int main()
{
    int d[4], h[8], r[8];
    int c1, c2, c4, error;
    int i;

    printf("=== Hamming Code - Sender Side ===");

    scanf("%d%d%d%d", &d[0], &d[1], &d[2], &d[3]);

    h[3] = d[0];
    h[5] = d[1];
    h[6] = d[2];
    h[7] = d[3];

    h[1] = (h[3] + h[5] + h[7]) % 2;
    h[2] = (h[3] + h[6] + h[7]) % 2;
    h[4] = (h[5] + h[6] + h[7]) % 2;

    printf(" Coding Table: Position : 1 2 3 4 5 6 7");
    printf(" Role : P1 P2 D1 P4 D2 D3 D4");

    printf(" Bits : ");
    for(i = 1; i <= 7; i++)
    {
        printf("%d ", h[i]);
    }

    printf("Encoded Codeword: ");
    for(i = 1; i <= 7; i++)
    {
        printf("%d", h[i]);
    }

    printf("=== Hamming Code - Receiver Side ===");

    for(i = 1; i <= 7; i++)
    {
        scanf("%d", &r[i]);
    }

    c1 = (r[1] + r[3] + r[5] + r[7]) % 2;
    c2 = (r[2] + r[3] + r[6] + r[7]) % 2;
    c4 = (r[4] + r[5] + r[6] + r[7]) % 2;

    error = c4 * 4 + c2 * 2 + c1;

    printf(" Syndrome Bits: C4=%d C2=%d C1=%d", c4, c2, c1);
    printf(" Error Position: %d", error);

    printf(" Data Sent : ");
    for(i = 1; i <= 7; i++)
    {
        printf("%d", h[i]);
    }

    printf(" Data Received : ");
    for(i = 1; i <= 7; i++)
    {
        printf("%d", r[i]);
    }

    if(error >= 1 && error <= 7)
    {
        printf(" Result: Error detected at bit position %d", error);
        r[error] = !r[error];
    }

    printf(" Corrected Codeword: ");
    for(i = 1; i <= 7; i++)
    {
        printf("%d", r[i]);
    }

    return 0;
}
